# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=PivotOps <notifications@pivotops.app>

# Paddle (billing)
PADDLE_API_KEY=your_paddle_api_key
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_PRICE_STARTER_MONTHLY=pri_...
PADDLE_PRICE_STARTER_ANNUAL=pri_...
PADDLE_PRICE_PROFESSIONAL_MONTHLY=pri_...
PADDLE_PRICE_PROFESSIONAL_ANNUAL=pri_...
PADDLE_PRICE_ENTERPRISE_MONTHLY=pri_...
PADDLE_PRICE_ENTERPRISE_ANNUAL=pri_...

# Admin
ADMIN_SECRET_TOKEN=your_secret_admin_token

# App
NEXT_PUBLIC_APP_URL=https://www.pivotops.app